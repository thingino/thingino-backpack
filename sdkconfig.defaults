CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
# For the memory report's list of every task's unused stack.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# The OTG controller takes the internal PHY, so the console must not use USB-Serial-JTAG.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# The partitions end at 3.1 MB, so a 4 MB image header lets one image boot on 4, 8 and
# 16 MB modules alike.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# No PSRAM. Images stream through the unit, so nothing it does scales with them, and a
# build that leaves PSRAM alone runs on every ESP32-S3 module whatever PSRAM it has.
# `./image.sh psram` layers sdkconfig.psram on top for octal-PSRAM modules.

# IPv6 first: SLAAC on top of the link-local address, and room for tokio's sockets.
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_MAX_SOCKETS=16

# Dev boards on marginal USB power brown out at Wi-Fi PHY calibration, the radio's largest
# current spike. Cap TX power, and let the PHY back off further after a brownout reset.
CONFIG_ESP_PHY_REDUCE_TX_POWER=y
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=13

# mDNS (the thingino app's `_thingino._tcp`) announces on the station alone: one
# interface and one service, instead of room for the AP, Ethernet and ten services.
CONFIG_MDNS_PREDEF_NETIF_AP=n
CONFIG_MDNS_PREDEF_NETIF_ETH=n
CONFIG_MDNS_MAX_INTERFACES=1
CONFIG_MDNS_MAX_SERVICES=2
CONFIG_MDNS_MULTIPLE_INSTANCE=n
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n

# Without PSRAM every received frame comes out of the internal heap. A LAN full of mDNS
# and SSDP chatter could take 32 dynamic buffers (51 KB) during a bootstrap; the
# daemon's TCP window needs four.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
