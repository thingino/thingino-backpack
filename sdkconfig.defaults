CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# The OTG controller takes the internal PHY, so the console must not use USB-Serial-JTAG.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# The ESP32-S3R8's embedded octal PSRAM. thingino-dfu pads a copy of U-Boot (~700 KB)
# before sending it, far more than internal RAM holds; large mallocs land in PSRAM while
# USB transfer buffers stay internal, where the OTG DMA can reach them.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# IPv6 first: SLAAC on top of the link-local address, and room for tokio's sockets.
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_MAX_SOCKETS=16

# Dev boards on marginal USB power brown out at Wi-Fi PHY calibration, the radio's largest
# current spike. Cap TX power, and let the PHY back off further after a brownout reset.
CONFIG_ESP_PHY_REDUCE_TX_POWER=y
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=13
